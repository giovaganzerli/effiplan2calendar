# Copiare questo file in .env e inserire la chiave reale.
# .env e' gitignorato: non committare mai chiavi reali.

# Chiave API Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Porta del server Express (opzionale, default 3001)
PORT=3001

# Root del front-end compilato (opzionale).
# Default: ../e2c-app/dist
WEB_ROOT=

# Dimensione massima dell'immagine caricata (opzionale, default 20mb)
MAX_UPLOAD=20mb

# Modelli Gemini da tentare, in ordine (opzionale).
# Il server ripiega sul primo modello che risponde.
GEMINI_MODEL=gemini-3-flash-preview,gemini-3.8-flash,gemini-flash-latest
